---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const root = (path = '') => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL;
---

<BaseLayout
  title="Comfy Space · 让 ComfyUI 成为团队共享的工作台"
  description="让团队多人共享 ComfyUI：统一管理账号与工作流，任务在中心排队并分配给空闲 GPU，进度与成果集中查看。"
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow"><span class="signal-dot"></span> 为团队打造的多用户 ComfyUI 工作台 <span class="eyebrow-line"></span> 0.6.1 候选版</div>
        <h1>多人共用 ComfyUI，<br /><em>不必再抢机器。</em></h1>
        <p>每个人在浏览器里提交任务。中心队列按权限与优先级分配空闲 GPU，工作流、进度和生成成果集中管理。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#capabilities">了解团队工作方式 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={root('guide/')}>查看部署方式 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-footnote"><span class="footnote-rule"></span> 多人同时提交 · 中心有序排队 · 多台 GPU 按需执行</div>
      </div>

      <div class="hero-visual" role="img" aria-label="中心任务队列将不同用户的任务按顺序分配给 GPU Worker 的示意图">
        <div class="visual-topline"><span><b class="visual-led"></b> SYSTEM LIVE VIEW</span><span>LAN / 3 NODES</span></div>
        <div class="visual-stage">
          <div class="visual-glow"></div>
          <div class="queue-stack">
            <div class="stack-label"><span>01 / CENTRAL QUEUE</span><span>中心队列</span></div>
            <div class="queue-row queued-row"><span class="queue-thumb thumb-a"></span><span class="queue-title"><b>概念图生成</b><small>设计组 · 工作流 v04</small></span><span class="queue-state">排队中</span></div>
            <div class="queue-row active-row"><span class="queue-thumb thumb-b"></span><span class="queue-title"><b>多参考图编辑</b><small>影像组 · 工作流 v02</small></span><span class="queue-state live">执行中</span></div>
            <div class="queue-row queued-row last-row"><span class="queue-thumb thumb-c"></span><span class="queue-title"><b>视频镜头生成</b><small>制作组 · 工作流 v01</small></span><span class="queue-state">排队中</span></div>
          </div>
          <div class="route-line"><i></i><span>LEASE / DISPATCH</span><i></i></div>
          <div class="worker-stack">
            <div class="stack-label"><span>02 / GPU WORKERS</span><span>执行节点</span></div>
            <div class="worker-row"><span class="node-icon">G1</span><span><b>GPU WORKER 01</b><small>ComfyUI · 正在生成</small></span><span class="worker-meter"><i></i></span></div>
            <div class="worker-row"><span class="node-icon">G2</span><span><b>GPU WORKER 02</b><small>ComfyUI · 可接单</small></span><span class="worker-ready"></span></div>
          </div>
        </div>
        <div class="visual-bottomline"><span>任务留在中心，算力按需接入</span><span>● ● ○</span></div>
      </div>
    </div>
  </section>

  <section class="proof-strip" aria-label="平台特点">
    <div class="container proof-inner">
      <div><strong>01</strong><span>多人提交，不争用机器</span></div>
      <div><strong>02</strong><span>工作流共享，权限清楚</span></div>
      <div><strong>03</strong><span>任务进度，随时可查</span></div>
      <div><strong>04</strong><span>图片视频，集中留存</span></div>
    </div>
  </section>

  <section id="capabilities" class="section capabilities-section">
    <div class="container">
      <div class="section-heading heading-split"><div><span class="kicker">THE PLATFORM</span><h2>团队共享算力，<br />每个人都有自己的入口。</h2></div><p>管理员管理权限和工作流，创作者专注提交与结果。任务在中心有序排队，过程清楚，成果可追。</p></div>
      <div class="feature-lines">
        <article class="feature-line"><span class="feature-index">01 / 调度</span><div><h3>一个中心队列，接入多台 GPU。</h3><p>用户任务先进入中心机。调度器结合优先级、公平轮转、Worker 能力与单槽容量派发，避免多人直接挤进同一台 ComfyUI。</p></div><span class="feature-glyph glyph-queue" aria-hidden="true">↗</span></article>
        <article class="feature-line"><span class="feature-index">02 / 工作流</span><div><h3>发布一次，团队按开放参数使用。</h3><p>管理员导入并测试 API 工作流，只公开需要填写的输入。已发布版本固定，任务会记录使用的版本和实际参数。</p></div><span class="feature-glyph glyph-workflow" aria-hidden="true">◇</span></article>
        <article class="feature-line"><span class="feature-index">03 / 追踪</span><div><h3>从提交到产物，留下完整线索。</h3><p>任务列表集中查看排队、进度、失败原因和结果。图片、视频与参考素材关联保存，支持预览、下载和克隆。</p></div><span class="feature-glyph glyph-track" aria-hidden="true">◎</span></article>
        <article class="feature-line"><span class="feature-index">04 / 探索</span><div><h3>用参数对比，更快找到方向。</h3><p>将公开参数组合成对比批次，每一格仍是普通中心任务；提示词片段与变量模板让重复创作更轻松。</p></div><span class="feature-glyph glyph-explore" aria-hidden="true">✳</span></article>
      </div>
    </div>
  </section>

  <section id="workflow" class="section workflow-section">
    <div class="container">
      <div class="section-heading"><span class="kicker">ONE CLEAR FLOW</span><h2>创作路径，清晰可见。</h2><p>工作流由管理员治理，生成任务交给中心队列，创作者专注输入与结果。</p></div>
      <div class="steps-line" aria-label="平台任务流程">
        <div class="step"><span class="step-number">01</span><span class="step-marker"></span><h3>发布工作流</h3><p>测试输入、固定版本、设置权限。</p></div>
        <div class="step"><span class="step-number">02</span><span class="step-marker"></span><h3>填写公开参数</h3><p>提示词、Seed 与可选参考素材。</p></div>
        <div class="step"><span class="step-number">03</span><span class="step-marker"></span><h3>中心排队调度</h3><p>按优先级与资源状态选择 Worker。</p></div>
        <div class="step"><span class="step-number">04</span><span class="step-marker"></span><h3>预览与归档</h3><p>查看结果、事件、失败原因与产物。</p></div>
      </div>
    </div>
  </section>

  <section id="direct-access" class="manual-section">
    <div class="container manual-grid">
      <div class="manual-diagram" aria-label="Worker 从平台任务切换到独占直接操作，再安全返回平台的流程">
        <div class="mode-caption"><span>CONTROLLED SWITCHOVER</span><span>独占切换</span></div>
        <div class="mode-path"><div class="mode-item"><span class="mode-dot"></span><span><b>平台接单</b><small>中心队列派发</small></span></div><div class="mode-connector"></div><div class="mode-item mode-active"><span class="mode-dot"></span><span><b>直接操作</b><small>授权用户独占</small></span></div><div class="mode-connector"></div><div class="mode-item"><span class="mode-dot"></span><span><b>安全归还</b><small>核对队列与归档</small></span></div></div>
        <div class="mode-detail"><span class="mode-pulse"></span><div><b>独占期间，平台停止向该 Worker 派发</b><small>标准 ComfyUI /prompt 任务可归档；插件专有接口仅记录访问审计。</small></div></div>
      </div>
      <div class="manual-copy"><span class="kicker">DIRECT ACCESS</span><h2>需要原生界面时，<br />也有一条受控的路。</h2><p>高级用户可按授权申请独占 ComfyUI 网页。平台先排空该节点现有任务，再开放操作；退出后核对本地队列与归档状态，确认安全才恢复派发。</p><a class="text-link dark-link" href={root('guide/#direct-access')}>查看完整操作说明 <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="container manual-instructions" aria-labelledby="manual-instructions-title">
      <div class="manual-instructions-heading"><span class="kicker">HOW TO USE</span><h3 id="manual-instructions-title">从申请到归还，四步完成。</h3></div>
      <ol class="manual-instructions-list">
        <li><span>01</span><div><b>获得节点授权</b><p>管理员在“直接操作”中，按用户或用户组授予指定 GPU 节点的权限。</p></div></li>
        <li><span>02</span><div><b>申请并等待交接</b><p>在工作台点击“申请直接操作”。现有平台任务和 ComfyUI 队列清空后，状态变为“直接操作中”。</p></div></li>
        <li><span>03</span><div><b>打开 ComfyUI 创作</b><p>点击“打开 ComfyUI”，通过中心机网关使用原生界面；标准任务会进入“直接操作记录”。</p></div></li>
        <li><span>04</span><div><b>结束并安全归还</b><p>点击“结束操作”。已有手动任务继续完成并归档，核对通过后 Worker 自动恢复平台接单。</p></div></li>
      </ol>
      <p class="manual-instructions-note">独占期间，平台任务仍在中心队列等待。插件专有接口若绕过标准任务接口，仅保留访问审计。</p>
    </div>
  </section>

  <section id="architecture" class="section architecture-section">
    <div class="container architecture-grid">
      <div class="architecture-copy"><span class="kicker">DEPLOY ON YOUR LAN</span><h2>两类安装包。<br />一套局域网工作台。</h2><p>中心机托管账号、API、调度器、资产与浏览器页面；GPU 机器运行 Worker 并连接本机 ComfyUI。管理员和普通用户从浏览器访问，不安装桌面客户端。</p><a class="button button-outline" href={root('guide/')}>查看部署指南 <span aria-hidden="true">↗</span></a></div>
      <div class="architecture-map" role="img" aria-label="浏览器连接中心机，中心机连接多台运行 ComfyUI 的 GPU Worker">
        <div class="map-row map-browser"><span class="map-icon">◻</span><span><b>BROWSER WORKSPACES</b><small>/admin · /app</small></span></div>
        <div class="map-spine"><span></span></div>
        <div class="map-row map-center"><span class="map-icon">▦</span><span><b>CENTER MACHINE</b><small>API · Scheduler · PostgreSQL · Assets</small></span><i>01</i></div>
        <div class="map-branches"><i></i><i></i></div>
        <div class="map-workers"><div class="map-row"><span class="map-icon">◆</span><span><b>GPU WORKER</b><small>Agent + Local ComfyUI</small></span></div><div class="map-row"><span class="map-icon">◆</span><span><b>GPU WORKER</b><small>Agent + Local ComfyUI</small></span></div></div>
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="container closing-grid"><div><span class="kicker">BUILDING IN THE OPEN</span><h2>让团队的算力，<br />真正成为团队的算力。</h2></div><div><p>项目现处于 0.6.1 候选阶段。可以先阅读部署方式与架构，正式发布还需完成跨机、证书与安装验收。</p><div class="closing-actions"><a class="button button-primary" href={root('guide/')}>阅读部署指南 <span aria-hidden="true">↗</span></a>{repositoryUrl && <a class="text-link" href={repositoryUrl} target="_blank" rel="noopener noreferrer">查看项目仓库 ↗</a>}</div></div></div>
  </section>
</BaseLayout>
